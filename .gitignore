# Ignore Jekyll build files
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore Ruby/Bundler files
.bundle/
vendor/
Gemfile.lock

# Ignore OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Ignore editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore log files
*.log

